DirectoryIndex index.html

# Prevent directory indexing
Options -Indexes

# Block public access to sensitive files, logs, scripts, and JSON data
<FilesMatch "\.(json|lock|env|git|sh|py|ipynb|log|ini|conf|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Force disable cache for dynamic updates
<IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Ensure Android APK packages are served with correct MIME type and downloaded directly
AddType application/vnd.android.package-archive .apk
<FilesMatch "\.apk$">
    <IfModule mod_headers.c>
        Header set Content-Disposition "attachment; filename=\"ViralClip-Studio.apk\""
    </IfModule>
</FilesMatch>
